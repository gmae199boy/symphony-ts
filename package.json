{
  "name": "symphony-ts",
  "version": "0.1.0",
  "description": "Symphony orchestration system — TypeScript port",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "symphony": "dist/index.js"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc",
    "docker:build": "docker build -t symphony-worker:latest -f docker/Dockerfile .",
    "dev": "node --env-file=.env --import tsx/esm src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.0",
    "@slack/web-api": "^7.15.1",
    "liquidjs": "^10.19.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
