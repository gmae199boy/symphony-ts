# ============================================================
# Symphony TS – 로컬 환경변수 (.gitignore에 포함됨)
# ============================================================

# ── Linear ──────────────────────────────────────────────────
LINEAR_API_KEY=
# LINEAR_ASSIGNEE=            # 필요 시 설정 (WORKFLOW.md의 assignee: 필드로 대체됨)

# ── GitHub ──────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Anthropic / Claude ──────────────────────────────────────
# claude CLI OAuth 세션을 사용하면 불필요
# ANTHROPIC_API_KEY=

# ── Jira (Jira 트래커 사용 시) ──────────────────────────────
# JIRA_API_TOKEN=              # Jira Cloud API 토큰 (https://id.atlassian.com/manage-profile/security/api-tokens)
# JIRA_EMAIL=                  # Jira Cloud 계정 이메일
# JIRA_HOST=                   # Jira Cloud 호스트 (예: https://your-org.atlassian.net)

# ── Bitbucket (Bitbucket repository 통합 사용 시) ─
# BITBUCKET_API_TOKEN=         # Bitbucket API 토큰 (Personal settings → API tokens) 또는 워크스페이스 토큰
# BITBUCKET_EMAIL=             # API 토큰 사용 시 필수: Atlassian 계정 이메일 (Basic 인증용). 워크스페이스 토큰만 쓰면 불필요
# BITBUCKET_WORKSPACE=         # Bitbucket workspace slug (WORKFLOW.md repository.workspace 또는 $BITBUCKET_WORKSPACE)

# ── Slack (계획 승인 워크플로우) ──────────────────────────────
SLACK_BOT_TOKEN=              # Slack Bot OAuth Token (xoxb-...)
SLACK_CHANNEL_ID=             # 계획 승인용 Slack 채널 ID
