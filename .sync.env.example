# `make remote-*` 명령어에서 사용하는 원격 서버 연결 설정.
# 이 파일을 .sync.env로 복사하고 값을 채워 넣으세요.
# .sync.env는 gitignore 처리되어 커밋되지 않습니다.

# SSH 사용자 및 호스트 (예: ec2-user@12.34.56.78)
SYNC_HOST=ec2-user@<IP>

# SSH 개인 키 경로 (EC2 키 페어의 .pem 파일).
# ~/.ssh/config를 사용하는 경우 비워두세요 (SETUP.md 참고).
SYNC_KEY=~/.ssh/my-key.pem

# 프로젝트가 배치될 원격 서버의 절대 경로.
SYNC_REMOTE_PATH=~/symphony
